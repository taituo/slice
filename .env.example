# --- core
DATABASE_URL=postgres://postgres:postgres@localhost:5432/slice
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
PUBLIC_URL=http://localhost:4000
PORT=4000
MCP_PORT=4100

# --- secrets (dev defaults are used when unset; production refuses to start without PII_KEY)
PII_KEY=change-me-per-region-from-kms
PHONE_PEPPER=change-me
ADMIN_API_KEY=dev-admin-key
PARTNER_API_KEY=dev-partner-key
COURIERCO_WEBHOOK_SECRET=dev-webhook-secret

# --- agent (rule-based fallback when unset)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- integrations (simulated when unset)
COURIERCO_URL=
COURIERCO_KEY=
GITHUB_TOKEN=
GITHUB_REPO=owner/slice-network

# --- scale-out
REGIONAL_QUEUES=false
WORKER_QUEUES=orders,ops
DELIVERY_RADIUS_KM=8

# --- tenants & agents
DEFAULT_TENANT=slice
LLM_API_KEY=                       # any OpenAI-compatible endpoint; falls back to DEEPSEEK_* then to rules
LLM_BASE_URL=
LLM_MODEL=
INTERNAL_API_KEY=dev-internal-key  # worker → API for durable A2A tasks
DEV_OTP_ECHO=true                  # dev only: return the sign-in code in the response

# --- voice (ElevenLabs) — see integrations/elevenlabs/README.md
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=dev-elevenlabs-secret
VOICE_LLM_KEY=dev-voice-llm-key
VOICE_TOOL_SECRET=dev-voice-secret
VOICE_TENANT=nearby

# --- MCP
MCP_TENANT=nearby
SLICE_ASSISTANT_TOKEN=             # stdio MCP: act for one person (token from "connect your assistant")
